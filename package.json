{
  "name": "team-timer",
  "version": "1.0.26",
  "description": "작업 타이머 - 마감까지 남은 시간을 한눈에",
  "main": "main.js",
  "author": "ADEF Video Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac --x64 --dir --publish never && node sign-mac.js x64 && electron-builder --mac --x64 --prepackaged dist/mac/TeamTimer.app --publish never && electron-builder --mac --arm64 --dir --publish never && node sign-mac.js arm64 && electron-builder --mac --arm64 --prepackaged dist/mac-arm64/TeamTimer.app --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:all": "electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "kr.co.adef.jakeop-timer",
    "productName": "작업 타이머",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "build-secrets.js",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/icon.icns",
      "build/tray.ico",
      "build/tray.png",
      "build/tray-dot.ico",
      "build/tray-dot.png",
      "build/overlay-dot.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/trayDotTemplate.png",
      "build/trayDotTemplate@2x.png"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "TeamTimer-${version}-${arch}.${ext}",
      "icon": "build/icon.icns",
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "작업 타이머",
      "artifactName": "TeamTimer-Setup-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "TeamTimer-${version}-${arch}.${ext}"
    }
  }
}